{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume Data",
  "description": "Schema for data.yaml — validates structure for build.py",
  "type": "object",
  "required": ["meta", "summary", "experience", "skills", "education"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "title", "email", "location", "available", "career_start"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "location": { "type": "string" },
        "available": { "type": "boolean" },
        "career_start": { "type": "integer", "minimum": 1970 },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": { "type": "string", "format": "uri" },
            "github": { "type": "string", "format": "uri" },
            "blog": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["company", "role", "location", "start", "end", "weight", "skills", "highlights"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string" },
          "via": { "type": "string", "description": "Consultancy company name" },
          "team": { "type": "string", "description": "Team within the company" },
          "role": { "type": "string" },
          "location": { "type": "string" },
          "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "ISO partial date, e.g. 2025-01" },
          "end": { "type": "string", "pattern": "^(present|\\d{4}-\\d{2})$", "description": "ISO partial date or 'present'" },
          "weight": { "type": "string", "enum": ["prominent", "standard", "compact"] },
          "visible": { "type": "boolean", "default": true, "description": "Set false to hide from both views" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "highlights": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["degree", "institution", "location", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "location": { "type": "string" },
          "start": { "type": "integer" },
          "end": { "type": "integer" }
        }
      }
    }
  }
}
