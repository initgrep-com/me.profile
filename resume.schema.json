{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume Data",
  "description": "Schema for resume.yaml — validates structure for build.py",
  "type": "object",
  "required": ["meta", "summary", "experience", "skills", "education"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "title", "email", "location", "available", "career_start"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "location": { "type": "string" },
        "available": { "type": "boolean" },
        "career_start": { "type": "integer", "minimum": 1970 },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": { "type": "string", "format": "uri" },
            "github": { "type": "string", "format": "uri" },
            "blog": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["company", "role", "location", "start", "end", "start_iso", "end_iso", "weight", "highlights", "tags"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string" },
          "badge": { "type": "string" },
          "role": { "type": "string" },
          "location": { "type": "string" },
          "ats_location": { "type": "string" },
          "ats_team": { "type": "string" },
          "ats_tags": { "type": "array", "items": { "type": "string" } },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "start_iso": { "type": "string" },
          "end_iso": { "type": "string" },
          "weight": { "type": "string", "enum": ["prominent", "standard", "compact"] },
          "compact_suffix": { "type": "string" },
          "dot": { "type": "string", "enum": ["large", "small"] },
          "highlights": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "ats_category": { "type": "string" },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "ats_items": { "type": "string" }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["degree", "institution", "location", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "location": { "type": "string" },
          "ats_location": { "type": "string" },
          "start": { "type": "integer" },
          "end": { "type": "integer" }
        }
      }
    }
  }
}
